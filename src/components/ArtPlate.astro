---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  image: ImageMetadata;
  imageAlt: string;
  title: string;
  venue: string;
  city: string;
  date: string;
}

const { image, imageAlt, title, venue, city, date } = Astro.props;
---

<figure class="art-plate">
  <Image src={image} alt={imageAlt} class="art-plate__image" widths={[300, 600, 900]} sizes="(min-width: 768px) 25vw, 50vw" />
  <figcaption class="art-plate__caption">
    <h3 class="font-display text-lg text-plum">{title}</h3>
    <p class="text-sm">{venue}, {city}</p>
    <p class="text-xs font-mono">{date}</p>
  </figcaption>
</figure>

<style>
  .art-plate {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .art-plate__image {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: 4px;
  }

  .art-plate__caption p {
    margin: 0;
    opacity: 0.75;
  }
</style>
