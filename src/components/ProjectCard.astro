---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import CrewBar from './CrewBar.astro';
import { formatDateRange } from '../lib/projects';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { title, client, yearStart, yearEnd, myRole, crew, cover, coverAlt } = project.data;
const dateRange = formatDateRange(yearStart, yearEnd);
---

<a href={`/work/${project.id}`} class="project-card">
  <Image src={cover} alt={coverAlt} class="project-card__cover" widths={[300, 500, 700]} sizes="(min-width: 768px) 30vw, 90vw" />
  <div class="project-card__body">
    <h3 class="font-display text-lg text-plum">{title}</h3>
    <p class="project-card__meta text-xs font-mono">{client} &middot; {dateRange}</p>
    <CrewBar myRole={myRole} crew={crew} />
  </div>
</a>

<style>
  .project-card {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    text-decoration: none;
    color: inherit;
  }

  .project-card__cover {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    object-position: center;
    border-radius: 2px;
    transition: opacity 0.15s ease;
  }

  .project-card:hover .project-card__cover,
  .project-card:focus-visible .project-card__cover {
    opacity: 0.85;
  }

  .project-card__body {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .project-card__meta {
    color: var(--color-plum);
    opacity: 0.7;
  }

  .project-card :global(.crew-bar__track) {
    max-width: 100%;
    height: 1.5rem;
  }
</style>
