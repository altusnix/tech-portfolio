---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Message sent | Robyn" description="Your message has been sent.">
  <section class="thank-you">
    <h1 class="font-display text-2xl text-plum">Message sent.</h1>
    <p class="text-lg">
      Thanks for reaching out. I'll get back to you within 24 hours.
    </p>
    <a href="/" class="thank-you__link">&larr; Back to home</a>
  </section>
</Layout>

<style>
  .thank-you {
    max-width: 40rem;
    margin-inline: auto;
    padding: 4rem 1.5rem;
    text-align: center;
  }

  .thank-you__link {
    display: inline-block;
    margin-top: 1.5rem;
    color: var(--color-plum);
  }
</style>
