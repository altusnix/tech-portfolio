---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import profilePhoto from '../assets/profile-photo/best-me.jpg';

const skillGroups = [
  {
    category: 'Frontend & Web',
    items: ['React', 'TypeScript', 'Next.js', 'Adobe AEM', 'Tailwind CSS', 'Accessibility (WCAG)'],
  },
  {
    category: 'AI & Emerging Tech',
    items: ['Agentic AI Workflows', 'Claude Code', 'GitHub Copilot', 'Prompt Engineering', 'LLM Integration'],
  },
  {
    category: 'Leadership',
    items: ['Technical Direction', 'Team Lead & Mentorship', 'Hiring & Team Building', 'Agile Coaching', 'DEIB'],
  },
  {
    category: 'CI/CD & Release',
    items: ['GitLab CI/CD', 'Jenkins', 'Release Governance', 'Agile', 'Scrum'],
  },
  {
    category: 'Creative',
    items: ['Figma', 'UI/UX Design', 'Design Systems', 'Typography', 'Brand Identity'],
  },
  {
    category: 'Security & Compliance',
    items: ['CAC/T3 Security Clearance (Active)', 'Federal Government Platform Compliance'],
  },
];
---

<Layout
  title="About — Robyn Stokes"
  description="Robyn Stokes: 20+ years spanning enterprise technology leadership and international visual arts."
>
  <section class="about">
    <Image src={profilePhoto} alt="Robyn Stokes" class="about__photo" widths={[300, 500, 700]} sizes="(min-width: 768px) 25vw, 60vw" />

    <div class="about__body">
      <h1 class="font-display text-2xl text-plum">About</h1>

      <p class="text-base">
        20+ years spanning enterprise technology leadership and international visual arts &mdash; two disciplines that,
        in practice, run on the same instinct for structure and problem-solving.
      </p>

      <p class="text-base">
        Most recently Technology Lead at Critical Mass in Chicago, promoted within 14 months of joining and holding
        active T3 government security clearance throughout. Grew and mentored a cross-functional team of 6 to 10
        developers delivering goarmy.com, a high-traffic recruitment platform serving millions of monthly visitors,
        while establishing the governance frameworks and release processes the team ran on. Also drove adoption of
        agentic AI development workflows &mdash; Claude Code, GitHub Copilot &mdash; into the delivery pipeline.
      </p>

      <p class="text-base">
        Founded the Women in Tech group at Critical Mass and served as Affinity Group Women's Lead for two years,
        building mentorship and career-development programming for women in technical roles &mdash; work recognized
        with a 2024 Women in Global Tech Community Award nomination.
      </p>

      <p class="text-base">
        BA in Interactive Multimedia from Columbia College Chicago, graduated with honors, with minors in Photography
        and Journalism. Has spoken at Columbia College Chicago, DePaul University, and Marriott, and been featured in
        Chicago Magazine, the Chicago Sun-Times, and The Reader.
      </p>

      <h2 class="font-display text-lg text-plum">Beyond the code</h2>
      <p class="text-base">
        From 2010 to 2018, served as Director of the Burton Chill program at Raging Buffalo &mdash; a Burton
        Snowboards initiative giving children without the financial means to experience snowboarding a way onto the
        mountain. Still snowboards and rides downhill MTB trails today; independently exhibiting as a fine artist in
        mixed media and flameworked glass since 2005, with 2025&ndash;2026 shows in New York, London, Detroit,
        Philadelphia, and Michigan.
      </p>
    </div>
  </section>

  <section class="skills" aria-labelledby="skills-heading">
    <h2 id="skills-heading" class="font-display text-xl text-plum">Skills</h2>
    <div class="skills__grid">
      {skillGroups.map((group) => (
        <div class="skills__group">
          <h3 class="text-sm skills__category">{group.category}</h3>
          <ul class="text-sm">
            {group.items.map((item) => <li>{item}</li>)}
          </ul>
        </div>
      ))}
    </div>
  </section>
</Layout>

<style>
  .about {
    display: grid;
    grid-template-columns: minmax(200px, 320px) 1fr;
    gap: 2.5rem;
    max-width: 56rem;
    margin-inline: auto;
    padding: 3rem 1.5rem 4rem;
    align-items: start;
  }

  .about__photo {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: 4px;
  }

  .about__body {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  @media (max-width: 640px) {
    .about {
      grid-template-columns: 1fr;
    }

    .about__photo {
      max-width: 16rem;
    }
  }

  .skills {
    max-width: 56rem;
    margin-inline: auto;
    padding: 0 1.5rem 4rem;
  }

  .skills__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: 2rem;
    margin-top: 1.5rem;
  }

  .skills__group ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .skills__category {
    /* brass-dark (3.53:1) was only verified for large text/non-text use —
       fails AA at this body-copy size. Plum (12.13:1) passes comfortably. */
    color: var(--color-plum);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 0.6rem;
    font-family: var(--font-mono);
  }
</style>
