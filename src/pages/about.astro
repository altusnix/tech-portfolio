---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import profilePhoto from '../assets/profile-photo/best-me.jpg';

const skillGroups = [
  {
    category: 'Frontend & Web',
    items: ['React', 'TypeScript', 'Next.js', 'Adobe AEM', 'Tailwind CSS', 'Accessibility (WCAG)'],
  },
  {
    category: 'AI & Emerging Tech',
    items: ['Agentic AI Workflows', 'Claude Code', 'GitHub Copilot', 'Prompt Engineering', 'LLM Integration'],
  },
  {
    category: 'Leadership',
    items: ['Technical Direction', 'Team Lead & Mentorship', 'Hiring & Team Building', 'Agile Coaching', 'DEIB'],
  },
  {
    category: 'CI/CD & Release',
    items: ['GitLab CI/CD', 'Jenkins', 'Release Governance', 'Agile', 'Scrum'],
  },
  {
    category: 'Creative',
    items: ['Figma', 'UI/UX Design', 'Design Systems', 'Typography', 'Brand Identity'],
  },
  {
    category: 'Security & Compliance',
    items: ['CAC/T3 Security Clearance (Active)', 'Federal Government Platform Compliance'],
  },
];
---

<Layout
  title="About | Robyn"
  description="Robyn: 20+ years spanning enterprise technology leadership and international visual arts."
>
  <section class="about">
    <h1 class="font-display text-2xl text-plum">About</h1>

    <Image src={profilePhoto} alt="Robyn" class="about__photo" widths={[160, 320, 480]} sizes="(min-width: 768px) 160px, 32vw" />

    <p class="text-base">
      Over twenty years spanning agency, enterprise, and federal government work, moving between technology
      lead, product owner, and project manager depending on what the engagement needed.
    </p>

    <p class="text-base">
      I've taken teams of six to ten developers through complete delivery cycles: discovery and scoping,
      backlog and sprint planning, stakeholder alignment, and release. Most recently that meant Technology Lead at
      Critical Mass in Chicago, promoted within 14 months of joining, leading the team behind goarmy.com, a
      high-traffic recruitment platform serving millions of monthly visitors, and establishing the governance and
      release processes it ran on.
    </p>

    <p class="text-base">
      Every build ships WCAG-compliant, and I've recently brought agentic AI tools (Claude Code, GitHub
      Copilot) into the delivery pipeline without slowing teams down. I carry an active T3 government
      security clearance.
    </p>

    <p class="text-base">
      Alongside the technical work, I've exhibited as a fine artist internationally since 2005. That studio
      practice (thinking in composition, hierarchy, and how something actually feels to use) carries
      directly into how I approach interfaces. <a href="/art">See the exhibition history &rarr;</a>
    </p>

    <p class="text-base about__cta">
      Looking for a technology leadership role that values both front-end craft and real delivery discipline.
      <a href="/contact">Let's talk</a>.
    </p>

    <h2 class="font-display text-lg text-plum">Beyond the code</h2>
    <p class="text-base">
      Directed the Burton Chill program at Raging Buffalo (2010&ndash;2018), a Burton Snowboards initiative
      putting kids without the means onto the mountain; still snowboards and rides downhill MTB today. Exhibiting
      as a fine artist in mixed media and flameworked glass since 2005. <a href="/art">Full exhibition history &rarr;</a>
    </p>
  </section>

  <section class="skills" aria-labelledby="skills-heading">
    <div class="skills__inner">
      <h2 id="skills-heading" class="font-display text-xl">Skills</h2>
      <div class="skills__grid">
        {skillGroups.map((group) => (
          <div class="skills__group">
            <h3 class="text-sm skills__category">{group.category}</h3>
            <ul class="text-sm">
              {group.items.map((item) => <li>{item}</li>)}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="facts">
    <ul class="text-sm about__facts">
      <li>Founded the Women in Tech group at Critical Mass</li>
      <li>Served as Affinity Group Women's Lead for two years</li>
      <li>Led mentorship and career-development programming for women in technical roles</li>
      <li>2024 Women in Global Tech Community Award nomination</li>
      <li>BA in Interactive Multimedia, Columbia College Chicago (honors; minors in Photography and Journalism)</li>
      <li>Spoken at Columbia College Chicago, DePaul University, and Marriott</li>
      <li>Featured in Chicago Magazine, the Chicago Sun-Times, and The Reader</li>
    </ul>
  </section>
</Layout>

<style>
  .about {
    display: flow-root;
    max-width: 60rem;
    margin-inline: auto;
    padding: 3rem 1.5rem 4rem;
  }

  .about h1 {
    margin-bottom: 1rem;
  }

  .about p {
    margin-bottom: 1rem;
  }

  .facts {
    max-width: 60rem;
    margin-inline: auto;
    padding: 3rem 1.5rem 4rem;
  }

  .about__facts {
    list-style: none;
    font-family: var(--font-mono);
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem 1.5rem;
  }

  .about__facts li {
    position: relative;
    padding-left: 1rem;
  }

  .about__facts li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-brass-dark);
  }

  @media (max-width: 640px) {
    .about__facts {
      grid-template-columns: 1fr;
    }
  }

  .about__photo {
    float: left;
    width: 160px;
    max-width: 32%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: 4px;
    margin: 0.25rem 1.5rem 1rem 0;
  }

  .about a {
    color: var(--color-plum);
  }

  .about a:hover,
  .about a:focus-visible {
    text-decoration: underline;
    text-underline-offset: 0.3em;
  }

  .about__cta {
    font-weight: 600;
    color: var(--color-plum);
    border-left: 3px solid var(--color-brass-dark);
    padding-left: 1rem;
  }

  @media (max-width: 640px) {
    .about__photo {
      float: none;
      display: block;
      width: 100%;
      max-width: 16rem;
      margin: 0 auto 1.5rem;
    }
  }

  .skills {
    background: var(--color-plum);
    padding: 3.5rem 1.5rem;
  }

  .skills__inner {
    max-width: 60rem;
    margin-inline: auto;
  }

  .skills__inner h2 {
    color: var(--color-brass);
  }

  .skills__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: 2rem;
    margin-top: 1.5rem;
  }

  .skills__group ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    color: var(--color-bone);
  }

  .skills__category {
    /* brass (4.54:1) is verified for plum/ink backgrounds specifically —
       see global.css. Passes AA here since .skills now has a plum background. */
    color: var(--color-brass);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 0.6rem;
    font-family: var(--font-mono);
  }

  .about h2 {
    margin-bottom: 0.75rem;
  }
</style>
