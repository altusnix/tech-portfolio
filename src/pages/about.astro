---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import profilePhoto from '../assets/profile-photo/best-me.jpg';

const skillGroups = [
  {
    category: 'Frontend & Web',
    items: ['React', 'TypeScript', 'Next.js', 'Vite', 'Adobe AEM', 'Tailwind CSS', 'HTML', 'Thymeleaf', 'Accessibility (WCAG)', 'Adobe Target', 'Google Analytics'],
  },
  {
    category: 'AI & Emerging Tech',
    items: ['Agentic AI Workflows', 'Claude Code', 'GitHub Copilot', 'Prompt Engineering', 'LLM Integration'],
  },
  {
    category: 'Leadership',
    items: ['Technical Direction', 'Team Lead & Mentorship', 'Teaching & Technical Coaching', 'Hiring & Team Building', 'Agile Coaching', 'Client Engagement & Stakeholder Alignment', 'DEI'],
  },
  {
    category: 'CI/CD & Release',
    items: ['GitLab CI/CD', 'Cypress & Test Automation', 'Jira & Confluence', 'Release Governance', 'Agile', 'Scrum'],
  },
  {
    category: 'Creative',
    items: ['Figma', 'Photoshop', 'Illustrator', 'Adobe XD', 'Adobe Premiere', 'UI/UX Design', 'Design Systems', 'Typography', 'Brand Identity', 'Animation'],
  },
  {
    category: 'Security & Compliance',
    items: [
      'CAC/T3 Security Clearance (Active)',
      'Section 508 & WCAG 2.2 AA',
      'Accessibility Audits & Remediation',
      'Application Security Remediation',
      'Pharma MLR Review',
      'Automotive Disclaimer Compliance',
      'Regulatory & Legal Coordination',
      'Compliance Documentation',
    ],
  },
];
---

<Layout
  title="About | Robyn"
  description="Robyn: 20+ years spanning enterprise technology leadership and international visual arts."
>
  <section class="about">
    <h1 class="font-display text-2xl text-plum">About</h1>
    <a href="#skills-heading" class="about__skills-link">View skills &darr;</a>

    <Image src={profilePhoto} alt="Robyn" class="about__photo" widths={[160, 320, 480]} sizes="(min-width: 768px) 160px, 32vw" />

    <p class="text-lg font-display about__lead">
      I design and build. Both, all the way through.
    </p>

    <p class="text-base">
      Twenty five years across agency, enterprise, and federal work. Most recently Technology Lead at
      Critical Mass in Chicago, promoted within 14 months of joining, leading the team behind goarmy.com.
      That is a recruitment platform serving millions of visitors a month for the U.S. Army, and I helped
      run the governance and release process behind it. I hold an active T3 government security clearance.
    </p>

    <p class="text-base">
      I have taken teams of six to ten developers through full delivery cycles. Discovery and scoping,
      backlog and sprint planning, keeping stakeholders in the loop, release. I have also worked as
      designer, product owner, project manager, and scrum master, because agency work rewards people who
      can cover the gap.
    </p>

    <p class="text-base">
      The design work runs end to end. User flows, wireframes, prototypes, and the interface that
      actually ships. Everything ships WCAG compliant. I brought agentic AI tools into the pipeline,
      Claude Code and GitHub Copilot, without slowing teams down, and taught a course series at Critical
      Mass on AI for prototyping to technical and non technical staff both.
    </p>

    <p class="text-base">
      I have shown work as a fine artist internationally since 2005. Composition, hierarchy, how a thing
      feels to use. Same questions the interface work asks. <a href="/art">See the exhibition history &rarr;</a>
    </p>

    <div class="about__cta">
      <p class="text-base">
        Looking for a technology leadership role that values both front end craft and real delivery discipline.
      </p>
      <a href="/contact" class="about__cta-link">Let's talk &rarr;</a>
    </div>

    <h2 class="font-display text-lg text-plum">Beyond the code</h2>
    <p class="text-base">
      Founded the Women in Tech group at Critical Mass and served as Affinity Group Women's Lead for two years,
      leading mentorship and career development programming for women in technical roles, recognized with a 2024
      Women in Global Tech Community Award nomination.
    </p>

    <p class="text-base">
      BA in Interactive Multimedia from Columbia College Chicago (honors; minors in Photography and Journalism).
      Spoken at Columbia College Chicago, DePaul University, and Marriott; featured in Chicago Magazine, the
      Chicago Sun-Times, and The Reader.
    </p>

    <p class="text-base">
      Directed the Burton Chill program at Raging Buffalo (2010&ndash;2018), a Burton Snowboards initiative
      putting kids without the means onto the mountain; still snowboards and rides downhill MTB today. Exhibiting
      as a fine artist in mixed media and flameworked glass since 2005. <a href="/art">Full exhibition history &rarr;</a>
    </p>
  </section>

  <section class="skills" aria-labelledby="skills-heading">
    <div class="skills__inner">
      <h2 id="skills-heading" class="font-display text-xl">Skills</h2>
      <div class="skills__grid">
        {skillGroups.map((group) => (
          <div class="skills__group">
            <h3 class="text-sm skills__category">{group.category}</h3>
            <ul class="text-sm">
              {group.items.map((item) => <li>{item}</li>)}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>
</Layout>

<style>
  .about {
    display: flow-root;
    max-width: 60rem;
    margin-inline: auto;
    padding: 3rem 1.5rem 4rem;
  }

  .about h1 {
    margin-bottom: 1rem;
  }

  .about__lead {
    color: var(--color-plum);
  }

  .about .about__skills-link {
    display: inline-block;
    margin-bottom: 1.5rem;
    padding: 0.75rem 1.5rem;
    border-radius: 4px;
    border: 1px solid var(--color-plum);
    color: var(--color-plum);
    text-decoration: none;
    font-weight: 600;
    transition: background-color 0.15s ease, color 0.15s ease;
  }

  .about .about__skills-link:hover,
  .about .about__skills-link:focus-visible {
    background: var(--color-plum);
    color: var(--color-bone);
    text-decoration: none;
  }

  .about p {
    margin-bottom: 1rem;
  }

  .about__photo {
    float: left;
    width: 160px;
    max-width: 32%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: 4px;
    margin: 0.25rem 1.5rem 1rem 0;
  }

  .about a {
    color: var(--color-plum);
    text-decoration: underline;
    text-underline-offset: 0.3em;
  }

  .about__cta {
    font-weight: 600;
    color: var(--color-plum);
    border-left: 3px solid var(--color-brass-dark);
    padding-left: 1rem;
    margin-block: 2rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .about__cta p {
    margin-bottom: 0;
  }

  .about .about__cta-link {
    display: inline-block;
    font-weight: 400;
    color: var(--color-plum);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    text-decoration: none;
  }

  .about .about__cta-link:hover,
  .about .about__cta-link:focus-visible {
    text-decoration: underline;
    text-underline-offset: 0.3em;
  }

  @media (max-width: 640px) {
    .about__photo {
      float: none;
      display: block;
      width: 100%;
      max-width: 16rem;
      margin: 0 auto 1.5rem;
    }
  }

  .skills {
    background: var(--color-plum);
    padding: 3.5rem 1.5rem;
  }

  .skills__inner {
    max-width: 60rem;
    margin-inline: auto;
  }

  .skills__inner h2 {
    color: var(--color-brass);
  }

  .skills__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: 2rem;
    margin-top: 1.5rem;
  }

  .skills__group ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    color: var(--color-bone);
  }

  .skills__category {
    /* brass (4.54:1) is verified for plum/ink backgrounds specifically —
       see global.css. Passes AA here since .skills now has a plum background. */
    color: var(--color-brass);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 0.6rem;
    font-family: var(--font-mono);
  }

  .about h2 {
    margin-top: 1rem;
    margin-bottom: 0.75rem;
  }
</style>
