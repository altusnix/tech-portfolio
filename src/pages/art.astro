---
import { getImage } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import ArtGallery from '../components/ArtGallery.tsx';
import { exhibitions } from '../lib/exhibitions';

const artImages = import.meta.glob<{ default: ImageMetadata }>('../assets/art-portfolio/*.{jpg,jpeg}', { eager: true });
// Watermarked copies, regenerated with: node scripts/watermark-art.mjs
// Used only for the full size lightbox image; grid thumbnails stay clean.
const watermarkedArtImages = import.meta.glob<{ default: ImageMetadata }>('../assets/art-portfolio-watermarked/*.{jpg,jpeg}', { eager: true });

function resolveImage(filename: string) {
  const entry = Object.entries(artImages).find(([path]) => path.endsWith(`/${filename}`));
  if (!entry) throw new Error(`Missing art image: ${filename}`);
  return entry[1].default;
}

function resolveWatermarkedImage(filename: string) {
  const entry = Object.entries(watermarkedArtImages).find(([path]) => path.endsWith(`/${filename}`));
  if (!entry) throw new Error(`Missing watermarked art image: ${filename}`);
  return entry[1].default;
}

function yearOf(date: string) {
  return date.split(' ').pop()!;
}

const years = [...new Set(exhibitions.map((ex) => yearOf(ex.date)))].sort((a, b) => Number(b) - Number(a));

const sorted = [...exhibitions].sort((a, b) => Number(yearOf(b.date)) - Number(yearOf(a.date)));

const pieces = await Promise.all(
  sorted.map(async (ex) => {
    const source = resolveImage(ex.image);
    const watermarkedSource = resolveWatermarkedImage(ex.image);
    const thumb = await getImage({ src: source, width: 500, format: 'webp' });
    const full = await getImage({ src: watermarkedSource, width: 1600, format: 'webp' });
    return {
      title: ex.title,
      venue: ex.venue,
      city: ex.city,
      date: ex.date,
      year: yearOf(ex.date),
      thumbSrc: thumb.src,
      fullSrc: full.src,
    };
  })
);
---

<Layout
  title="Art | Robyn"
  description="Exhibition history and visual art practice by Robyn, spanning galleries in the U.S. and abroad."
>
  <section class="art-page">
    <header class="art-page__header">
      <h1 class="font-display text-2xl text-plum">Visual Art</h1>
      <p class="text-lg">
        Exhibited nationally and internationally. Art is a driving passion in its own right, and it continually
        informs how I approach visual problem-solving in technology work too.
      </p>
    </header>

    <ArtGallery client:visible pieces={pieces} years={years} />
  </section>
</Layout>

<style>
  .art-page {
    max-width: 64rem;
    margin-inline: auto;
    padding: 2rem 1.5rem 4rem;
  }

  .art-page__header {
    padding-block: 1rem 2.5rem;
    max-width: 40rem;
  }
</style>
