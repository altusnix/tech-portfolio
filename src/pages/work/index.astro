---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { sortProjectsNewestFirst } from '../../lib/projects';

const allProjects = await getCollection('projects');
const projects = sortProjectsNewestFirst(allProjects);
---

<Layout
  title="Work — Robyn Stokes"
  description="Technology projects led and built by Robyn Stokes, spanning government platforms, enterprise systems, and immersive experiences."
>
  <section class="work-index">
    <header class="work-index__header">
      <h1 class="font-display text-2xl text-plum">Work</h1>
      <p class="text-lg">Government platforms, enterprise systems, and immersive experiences — built with teams ranging from solo to eleven.</p>
    </header>

    <div class="work-index__grid">
      {projects.map((project) => (
        <ProjectCard project={project} headingLevel="h2" />
      ))}
    </div>
  </section>
</Layout>

<style>
  .work-index {
    max-width: 64rem;
    margin-inline: auto;
    padding: 2rem 1.5rem 4rem;
  }

  .work-index__header {
    padding-block: 1rem 2rem;
    border-bottom: 1px solid var(--color-plum);
    max-width: 40rem;
  }

  .work-index__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: 2.5rem 2rem;
    margin-top: 2.5rem;
  }
</style>
