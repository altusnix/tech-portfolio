---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contact | Robyn" description="Get in touch with Robyn about your next project.">
  <section class="contact">
    <h1 class="font-display text-2xl text-plum">Contact</h1>
    <p class="text-lg">Let's talk about what you're building.</p>

    <div class="contact__grid">
      <!--
        Works with zero JavaScript: this is a plain form POST that redirects
        to /contact/thank-you on success, which is what gives us a real
        focus-moving success state without writing any client-side code.
      -->
      <form class="contact__form" method="POST" action="https://api.web3forms.com/submit" aria-label="Contact form">
        <input type="hidden" name="access_key" value="5d9aab6c-dbcf-4303-9827-f257f10780df" />
        <input type="hidden" name="subject" value="New message from altusnixportfolio" />
        <input type="hidden" name="redirect" value="https://tech-portfolio.altusnix.workers.dev/contact/thank-you" />
        <input type="checkbox" name="botcheck" class="sr-only" tabindex="-1" autocomplete="off" aria-label="Leave this field blank" />

        <div class="contact__field">
          <label for="contact-name" class="text-sm">Your name</label>
          <input type="text" id="contact-name" name="name" required aria-describedby="name-help" />
          <span id="name-help" class="sr-only">Please enter your full name</span>
        </div>

        <div class="contact__field">
          <label for="contact-email" class="text-sm">Email address</label>
          <input type="email" id="contact-email" name="email" required aria-describedby="email-help" />
          <span id="email-help" class="sr-only">Please enter a valid email address</span>
        </div>

        <div class="contact__field">
          <label for="contact-message" class="text-sm">Project details</label>
          <textarea id="contact-message" name="message" rows="5" required aria-describedby="message-help"></textarea>
          <span id="message-help" class="sr-only">Please describe your project or inquiry</span>
        </div>

        <button type="submit" class="contact__submit">Send message</button>
      </form>

      <div class="contact__info text-sm">
        <div>
          <h2 class="font-display text-lg text-plum">Email</h2>
          <p><a href="mailto:altusnix@gmail.com">altusnix@gmail.com</a></p>
        </div>
        <div>
          <h2 class="font-display text-lg text-plum">Location</h2>
          <p>Detroit Metropolitan Area</p>
        </div>
        <div>
          <h2 class="font-display text-lg text-plum">Response time</h2>
          <p>&lt; 24 hours</p>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .contact {
    max-width: 48rem;
    margin-inline: auto;
    padding: 2rem 1.5rem 4rem;
  }

  .contact__grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: 3rem;
    margin-top: 2rem;
  }

  .contact__form {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .contact__field {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .contact__field input,
  .contact__field textarea {
    border: 1px solid var(--color-plum);
    border-radius: 4px;
    padding: 0.6rem 0.75rem;
    background: var(--color-bone);
    color: var(--color-ink);
    font-family: var(--font-body);
  }

  .contact__submit {
    align-self: start;
    background: var(--color-plum);
    color: var(--color-bone);
    border: none;
    border-radius: 4px;
    padding: 0.75rem 1.5rem;
    font-family: var(--font-body);
    font-weight: 600;
    cursor: pointer;
  }

  .contact__info {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .contact__info a {
    color: var(--color-plum);
  }

  .contact__info a:hover,
  .contact__info a:focus-visible {
    text-decoration: underline;
    text-underline-offset: 0.3em;
  }

  @media (max-width: 640px) {
    .contact__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
